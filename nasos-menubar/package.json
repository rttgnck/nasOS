{
  "name": "nasos-connect",
  "productName": "nasOS Connect",
  "version": "1.0.0",
  "description": "macOS menu bar app to access your nasOS device",
  "main": "src/main.js",
  "scripts": {
    "start": "env -u ELECTRON_RUN_AS_NODE electron .",
    "dev": "env -u ELECTRON_RUN_AS_NODE electron . --dev",
    "generate-icons": "node scripts/generate-icons.js",
    "prebuild": "npm run generate-icons",
    "build": "env -u ELECTRON_RUN_AS_NODE electron-builder --mac",
    "dist": "npm run generate-icons && env -u ELECTRON_RUN_AS_NODE electron-builder --mac --publish never"
  },
  "build": {
    "appId": "com.nasos.connect",
    "productName": "nasOS Connect",
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "assets/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "darkModeSupport": true
    },
    "dmg": {
      "title": "nasOS Connect",
      "iconSize": 80,
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "!assets/nasos-logo.svg",
      "!assets/*.iconset"
    ],
    "extraMetadata": {
      "main": "src/main.js"
    }
  },
  "devDependencies": {
    "electron": "^41.1.0",
    "electron-builder": "^25.1.8",
    "sharp": "^0.33.5"
  }
}
