[Unit]
Description=nasOS SATA Drive Auto-Mount
# Run after local filesystems, network, and the backend data dir are ready.
# dev-disk-by is not used because we wait for devices inside the script.
After=local-fs.target nasos-firstboot.service
Wants=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/nasos/scripts/storage-mount.sh auto-mount
TimeoutStartSec=120
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
