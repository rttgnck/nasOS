[Unit]
Description=nasOS SATA Drive Auto-Mount
After=local-fs.target nasos-firstboot.service systemd-udev-settle.service
Wants=local-fs.target systemd-udev-settle.service
Before=nasos-backend.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/nasos/scripts/storage-mount.sh auto-mount
TimeoutStartSec=120
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
